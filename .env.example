# Copy to .env and fill in. Never commit .env.

# Firebase web app (public): Firebase console > Project settings > General >
# Your apps > SDK setup and configuration.
NEXT_PUBLIC_apiKey=
NEXT_PUBLIC_authDomain=
NEXT_PUBLIC_projectId=
NEXT_PUBLIC_storageBucket=
NEXT_PUBLIC_messagingSenderId=
NEXT_PUBLIC_appId=
NEXT_PUBLIC_measurementId=

# Google reCAPTCHA v2 ("I'm not a robot" checkbox): https://www.google.com/recaptcha/admin
# Add kostuma.vercel.app and localhost to the key's domains.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# YouCam API (server only): https://yce.makeupar.com/api-console/en/api-keys/
YOUCAM_API_GENERATED_KEY=
# Only used by YouCam's legacy v1 auth. Kostuma uses the v2 API; leave it out of Vercel.
YOUCAM_API_SECRET_KEY=
